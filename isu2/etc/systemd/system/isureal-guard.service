[Unit]
Description=isureal-guard
After=network-online.target
Wants=network-online.target

[Service]
User=isucon
Group=isucon
SupplementaryGroups=systemd-journal
EnvironmentFile=/home/isucon/env.sh
Environment=GUARD_JOURNAL_UNIT=isureal-*.service
Environment=GUARD_FAIL_THRESHOLD=10
Environment=GUARD_FAIL_WINDOW=10s
Environment=GUARD_BAN_DURATION=2m
ExecStart=/opt/isureal-guard/bin/isureal-guard
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
