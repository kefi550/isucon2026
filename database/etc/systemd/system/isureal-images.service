[Unit]
Description=isureal initial image store (nginx)
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/nginx/isureal-images.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/isureal-images.conf -g 'daemon off;'
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
